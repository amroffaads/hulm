local function LoadTrack()
    if CurrentTrack then CurrentTrack:Stop(0) end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. emoteId

    pcall(function()
        local objs = game:GetObjects(anim.AnimationId)
        if objs and #objs > 0 and objs[1]:IsA("Animation") then
            anim.AnimationId = objs[1].AnimationId
        end
    end)

    local success, track = pcall(function() return humanoid:LoadAnimation(anim) end)
    if success and track then
        CurrentTrack = track
        CurrentTrack.Priority = Enum.AnimationPriority.Action4
        CurrentTrack:Play(0.1, Settings.Weight, 0)
        CurrentTrack.TimePosition = Settings["Time Position"] * CurrentTrack.Length
    end
end

