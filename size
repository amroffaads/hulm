local function sendHDCommand(cmd)
    task.spawn(function()
        local hdSignals = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        if hdSignals then
            hdSignals = hdSignals:FindFirstChild("Signals")
        end
        local remote = hdSignals and hdSignals:FindFirstChild("RequestCommandSilent")
        if remote then
            remote:InvokeServer("." .. cmd)
        else
            local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatEvent then
                chatEvent = chatEvent:FindFirstChild("SayMessageRequest")
                if chatEvent then
                    chatEvent:FireServer("." .. cmd, "All")
                end
            end
        end
    end)
end

