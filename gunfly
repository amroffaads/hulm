-- ═══════════════════════════════════════════════════════════════════
-- نظام الهجوم (بدون تغيير)
-- ═══════════════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    if OrbitActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local tool = LocalPlayer.Character:FindFirstChild(getgenv().AttackSystem.TOOL_NAME)
        local oldPos = hrp.CFrame

        if not dummyPart then
            dummyPart = Instance.new("Part")
            dummyPart.Name = "CameraAnchor"
            dummyPart.Anchored = true
            dummyPart.Transparency = 1
            dummyPart.CanCollide = false
            dummyPart.Parent = Workspace
            originalCameraSubject = Workspace.CurrentCamera.CameraSubject
            Workspace.CurrentCamera.CameraSubject = dummyPart
        end

        if dummyPart then
            dummyPart.CFrame = oldPos * CFrame.new(0, 1.5, 0)
        end

        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local tRoot = target.Character.HumanoidRootPart
            local tChar = target.Character

            local predictedPosition = tRoot.Position + (tRoot.Velocity * PredictionIntensity)
            local tSize = tChar:GetExtentsSize().Y
            local dynamicHeight = -(tSize * 0.3)

            local armOffset = 0.7
            if tool and tool:FindFirstChild("Handle") then
                armOffset = (hrp.Position - tool.Handle.Position).Magnitude
            end

            local dynamicRadius = armOffset * 1

            angle = angle + Speed
            local x = math.cos(math.rad(angle)) * dynamicRadius
            local z = math.sin(math.rad(angle)) * dynamicRadius

            local orbitPosition = predictedPosition + Vector3.new(x, dynamicHeight, z)
            local calculatedPosition = CFrame.new(orbitPosition, predictedPosition)
                                         * CFrame.Angles(0, math.rad(WeaponAngleOffset), 0)

            if getgenv().AttackSystem.Desync == true then
                local abc = hrp.Velocity
                hrp.CFrame = calculatedPosition
                hrp.Velocity = getgenv().AttackSystem.Direction * (2^100)
                RunService.RenderStepped:Wait()
                if hrp and hrp.Parent then
                    hrp.Velocity = abc
                    hrp.CFrame = oldPos
                end
            else
                hrp.CFrame = calculatedPosition
                RunService.RenderStepped:Wait()
                if hrp and hrp.Parent then
                    hrp.CFrame = oldPos
                end
            end
        end
    end
end)

