local function stopAttack()
    OrbitActive = false
    ContinuousMode = false
    target = nil
    task.wait(0.05)
    if dummyPart then
        if originalCameraSubject and originalCameraSubject.Parent then
            Workspace.CurrentCamera.CameraSubject = originalCameraSubject
        else
            Workspace.CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        end
        dummyPart:Destroy()
        dummyPart = nil
    end
    ToggleBtn.Text = "▶ تشغيل"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
end

local function getTarget(name)
    for _, v in pairs(game:GetService("Players"):GetPlayers()) do
        if v ~= LocalPlayer and (v.Name:lower():find(name:lower()) or v.DisplayName:lower():find(name:lower())) then
            return v
        end
    end
    return nil
end

