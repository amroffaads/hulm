local function guiValueToCFrameSpeed(guiValue)
    guiValue = math.clamp(guiValue, MIN_SPEED_GUI, MAX_SPEED_GUI)
    local ratio = (guiValue - MIN_SPEED_GUI) / (MAX_SPEED_GUI - MIN_SPEED_GUI)
    return MIN_SPEED_CFRAME + (ratio * (MAX_SPEED_CFRAME - MIN_SPEED_CFRAME))
end

