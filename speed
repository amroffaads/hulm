-- [ UPDATE TOGGLE VISUALS ]
-- ═════════════════════════════════════════════
local function updateToggleVisuals(isOn)
    local targetBg = isOn and Colors.ButtonOn or Colors.ButtonOff
    local targetText = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(225, 95, 95)
    local targetStroke = isOn and Color3.fromRGB(75, 195, 115) or Color3.fromRGB(205, 75, 75)

    tween(ToggleBtn, {BackgroundColor3 = targetBg}, 0.25)
    tween(ToggleBtn, {TextColor3 = targetText}, 0.25)
    tween(TgStroke, {Color = targetStroke}, 0.25)
    ToggleBtn.Text = isOn and "ON" or "OFF"

    if MobileToggleBtn then
        tween(MobileToggleBtn, {BackgroundColor3 = targetBg}, 0.25)
        tween(MobileToggleBtn, {TextColor3 = targetText}, 0.25)
        local mtbStroke = MobileToggleBtn:FindFirstChildOfClass("UIStroke")
        if mtbStroke then
            tween(mtbStroke, {Color = targetStroke}, 0.25)
        end
        MobileToggleBtn.Text = isOn and "ON" or "OFF"
    end
end

-- ═════════════════════════════════════════════
-- [ TOGGLE ON/OFF ]
-- ═════════════════════════════════════════════
local function toggleSpeed()
    isSpeedEnabled = not isSpeedEnabled
    updateToggleVisuals(isSpeedEnabled)
    if isSpeedEnabled then
        local actual = guiValueToCFrameSpeed(currentSpeedValue)
    else
    end
end

ToggleBtn.MouseButton1Click:Connect(toggleSpeed)
