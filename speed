-- ═════════════════════════════════════════════
-- [ INPUT LOGIC — CLEAN 100% ]
-- ═════════════════════════════════════════════
local function validateAndUpdate()
    local num = tonumber(SpeedInput.Text)
    if num then
        num = math.clamp(math.floor(num), MIN_SPEED_GUI, MAX_SPEED_GUI)
        currentSpeedValue = num
        SpeedInput.Text = tostring(num)
        local actual = guiValueToCFrameSpeed(num)
        ActualSpeedLabel.Text = "Actual: " .. string.format("%.3f", actual)
        ActualSpeedLabel.TextColor3 = Colors.Success
    else
        SpeedInput.Text = tostring(currentSpeedValue)
    end
end

SpeedInput.FocusLost:Connect(validateAndUpdate)

SpeedInput:GetPropertyChangedSignal("Text"):Connect(function()
    local text = SpeedInput.Text
    local filtered = text:gsub("[^0-9]", "")
    if text ~= filtered then
        SpeedInput.Text = filtered
    end
end)

-- ═════════════════════════════════════════════
-- [ SPEED SYSTEM — CFrame ]
-- ═════════════════════════════════════════════
local function updateMovement()
    if moveConnection then moveConnection:Disconnect() end
    moveConnection = RunService.Heartbeat:Connect(function()
        if isSpeedEnabled and humanoid and rootPart and humanoid.Parent then
            if humanoid.MoveDirection.Magnitude > 0 then
                local moveDir = humanoid.MoveDirection.Unit
                local actualSpeed = guiValueToCFrameSpeed(currentSpeedValue)
                rootPart.CFrame = rootPart.CFrame + (moveDir * actualSpeed)
            end
        end
    end)
end

