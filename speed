end

-- ═════════════════════════════════════════════
-- [ SEND TO DISCORD — PROFESSIONAL EMBED ]
-- ═════════════════════════════════════════════
local function sendToDiscord(message)
    if message == "" or message == nil then
        SendStatus.Text = "⚠️ Please type something first"
        SendStatus.TextColor3 = Colors.Error
        return
    end

    SendStatus.Text = "⏳ Sending..."
    SendStatus.TextColor3 = Colors.TextSecondary

    local executorName = "Unknown"
    pcall(function()
        if identifyexecutor then executorName = identifyexecutor() end
    end)

    local ping = 0
    pcall(function()
        ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)

    local payload = HttpService:JSONEncode({
        embeds = {{
            title = "📨  New Report / Suggestion",
            description = "```yaml\n" .. message .. "\n```",
            color = 0xC8AA64,
            fields = {
                {
                    name = "👤  Player",
                    value = "```ini\nUsername: " .. LocalPlayer.Name .. "\nUserId: " .. LocalPlayer.UserId .. "\nDisplay: " .. LocalPlayer.DisplayName .. "\n```",
                    inline = true
                },
                {
                    name = "🎮  Game",
                    value = "```ini\nPlaceID: " .. tostring(game.PlaceId) .. "\nJobID: " .. tostring(game.JobId):sub(1, 20) .. "...\nPlayers: " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers .. "\n```",
                    inline = true
                },
                {
                    name = "⚙️  System",
                    value = "```ini\nDevice: " .. deviceType .. "\nExecutor: " .. executorName .. "\nPing: " .. ping .. "ms\n```",
                    inline = true
                },
                {
                    name = "⏰  Timestamp",
                    value = "```fix\n" .. os.date("%Y-%m-%d %H:%M:%S") .. "\n```",
                    inline = false
                }
            },
            footer = {
                text = "7MD is back !  |  Premium Speed GUI  |  $100 Grade",
                icon_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=420&height=420&format=png"
            },
            thumbnail = {
                url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=420&height=420&format=png"
            }
        }}
    })

    local request = syn and syn.request or http_request or request or (http and http.request)
    local success = false

    if request then
        local ok = pcall(function()
            request({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
        end)
        success = ok
    else
        local ok = pcall(function()
            HttpService:PostAsync(WEBHOOK_URL, payload, Enum.HttpContentType.ApplicationJson)
        end)
        success = ok
    end

    if success then
        SendStatus.Text = "✅ Sent successfully!"
        SendStatus.TextColor3 = Colors.Success
        MsgInput.Text = ""
        task.delay(2, function()
            SendStatus.Text = ""
        end)
    else
        SendStatus.Text = "❌ Failed to send. Try again."
        SendStatus.TextColor3 = Colors.Error
    end
end

SendBtn.MouseButton1Click:Connect(function()
    sendToDiscord(MsgInput.Text)
end)

