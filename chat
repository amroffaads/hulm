            end
        end)

        -- أنيميشن دخول
        container.BackgroundTransparency = 1
        for _, child in pairs(container:GetDescendants()) do
            if child:IsA("TextLabel") then child.TextTransparency = 1 end
            if child:IsA("ImageLabel") then child.ImageTransparency = 1 end
            if child:IsA("TextButton") then child.TextTransparency = 1 end
        end

        task.delay(0.05, function()
            TweenService:Create(container, TweenInfo.new(0.4), {BackgroundTransparency = 0}):Play()
            for _, child in pairs(container:GetDescendants()) do
                if child:IsA("TextLabel") then TweenService:Create(child, TweenInfo.new(0.4), {TextTransparency = 0}):Play() end
                if child:IsA("ImageLabel") then TweenService:Create(child, TweenInfo.new(0.4), {ImageTransparency = 0}):Play() end
                if child:IsA("TextButton") then TweenService:Create(child, TweenInfo.new(0.4), {TextTransparency = 0}):Play() end
            end
        end)

        task.defer(scrollToBottom)
    end

    -- ═══════════════════════════════════════════════════════════════════
    -- إرسال الرسائل
    -- ═══════════════════════════════════════════════════════════════════
    local function sendNormalMessage()
        if InputBox.Text == "" then return end
        local msg = InputBox.Text
        InputBox.Text = ""

        local payload = HttpService:JSONEncode({
            username = player.Name,
            userId = player.UserId,
            message = msg,
            isHelpRequest = false
        })

        task.spawn(function()
            tryRequest("/update", "POST", payload)
        end)
    end

    local function sendHelpRequest()
        local serverInfo = getCurrentServerInfo()

        local payload = HttpService:JSONEncode({
            username = player.Name,
            userId = player.UserId,
            message = "🚨 طلب فزعه - انضم إلي!",
            jobId = serverInfo.jobId,
            placeId = serverInfo.placeId,
            playerCount = serverInfo.playerCount,
            maxPlayers = serverInfo.maxPlayers,
            gameName = serverInfo.gameName,
            isHelpRequest = true
        })

        task.spawn(function()
            tryRequest("/update", "POST", payload)
        end)
    end

    SendButton.MouseButton1Click:Connect(sendNormalMessage)
    HelpButton.MouseButton1Click:Connect(sendHelpRequest)

    InputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then sendNormalMessage() end
    end)

    -- ═══════════════════════════════════════════════════════════════════
    -- التصغير والإغلاق
    -- ═══════════════════════════════════════════════════════════════════
    local isMinimized = false

    MinimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        if isMinimized then
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
                Size = UDim2.new(0, 260, 0, 36)
            }):Play()
            MessageContainer.Visible = false
            InputFrame.Visible = false
            OnlineCounter.Visible = false
            MinimizeBtn.Text = "+"
        else
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
                Size = UDim2.new(0, 260, 0, 400)
            }):Play()
            task.wait(0.25)
            MessageContainer.Visible = true
            InputFrame.Visible = true
            OnlineCounter.Visible = true
            MinimizeBtn.Text = "−"
            scrollToBottom()
        end
    end)



    -- ═══════════════════════════════════════════════════════════════════
    -- جلب الرسائل من السيرفر
    -- ═══════════════════════════════════════════════════════════════════
    local function fetchMessages()
        local response = tryRequest("/data", "GET")
        if not response or not response.Body then return end

        local success, messages = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not success or type(messages) ~= "table" then return end

        for _, msg in ipairs(messages) do
            if not lastMessageIds[msg.id] then
                if msg.isHelpRequest then
                    addHelpRequestMessage({
                        username = msg.username,
                        userId = msg.userId,
                        placeId = msg.placeId or game.PlaceId,
                        jobId = msg.jobId,
                        playerCount = msg.playerCount or 0,
                        maxPlayers = msg.maxPlayers or 50,
                        gameName = msg.gameName or "لعبة غير معروفة"
                    }, msg.id)
                else
                    local isOwn = (msg.username == player.Name)
                    addNormalMessage(msg.username, msg.message, isOwn, msg.id)
                end
            end
        end
    end

    -- تحديث كل 2 ثانية
    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            fetchMessages()
            task.wait(2)
        end
    end)

    -- ═══════════════════════════════════════════════════════════════════
    -- تحديث عداد المتصلين
    -- ═══════════════════════════════════════════════════════════════════
    local function updateOnlineCount()
        task.spawn(function()
            local response = tryRequest("/online-count", "GET")
            if not response or not response.Body then return end

            local success, data = pcall(function()
                return HttpService:JSONDecode(response.Body)
            end)

            if success and data and data.count then
                CounterText.Text = data.count .. " متصل"
            end
        end)
    end

    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            updateOnlineCount()
            task.wait(10)
        end
    end)

    -- ═══════════════════════════════════════════════════════════════════
    -- أنيميشن دخول الواجهة
    -- ═══════════════════════════════════════════════════════════════════
    MainFrame.Size = UDim2.new(0, 260, 0, 0)
    MainFrame.BackgroundTransparency = 1

    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 260, 0, 400),
        BackgroundTransparency = 0.06
    }):Play()

    -- إشعار التحميل
    StarterGui:SetCore("SendNotification", {
        Title = "💬 HULM Chat",
        Text = "تم تحميل الشات العالمية v2.1 (Slim)",
        Duration = 3
    })

end

