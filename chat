    -- ═══════════════════════════════════════════════════════════════════
    -- دوال الاتصال
    -- ═══════════════════════════════════════════════════════════════════
    local function getActiveUrl()
        return MY_URLS[currentUrlIndex]
    end

    local function switchToNextUrl()
        currentUrlIndex = currentUrlIndex + 1
        if currentUrlIndex > #MY_URLS then
            currentUrlIndex = 1
        end
        
    end

    local function sendRequest(url, method, body)
        local requestFunc = syn and syn.request or http_request or request or (http and http.request)
        if requestFunc then
            return requestFunc({
                Url = url,
                Method = method,
                Headers = {["Content-Type"] = "application/json"},
                Body = body
            })
        end
        return nil
    end

    local function safeRequest(url, method, body)
        local success, response = pcall(function()
            return sendRequest(url, method, body)
        end)
        
        if not success or not response then
            return nil
        end
        
        if response.StatusCode and (response.StatusCode >= 500 or response.StatusCode == 0) then
            return nil
        end
        
        return response
    end

    local function tryRequest(endpoint, method, body)
        local attempts = 0
        local maxAttempts = #MY_URLS
        
        while attempts < maxAttempts do
            local url = getActiveUrl() .. endpoint
            local response = safeRequest(url, method, body)
            
            if response then
                return response
            end
            
            switchToNextUrl()
            attempts = attempts + 1
        end
        
        return nil
    end

    local function pingServer()
        local payload = HttpService:JSONEncode({
            userId = player.UserId,
            username = player.Name
        })
        task.spawn(function()
            tryRequest("/ping", "POST", payload)
        end)
    end

    -- Ping كل 5 ثواني
    task.spawn(function()
        while true do
            pingServer()
            task.wait(5)
        end
    end)

