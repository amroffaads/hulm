            mode = "TORNADO"
        elseif wordKey == "COUNTDOWN" then
            isAnimating = true
            mode = "SHAPE"
            currentTask = task.spawn(function()
                while isAnimating do
                    for i = 10, 1, -1 do
                        currentPoints = Words[tostring(i)]
                        updatePositions()
                        task.wait(1.2)
                    end
                    startScatter()
                    task.wait(5)
                    if not isAnimating then break end
                end
            end)
        elseif wordKey == "ANIMATE" then
            isAnimating = true
            mode = "SHAPE"
            currentTask = task.spawn(function()
                while isAnimating do
                    currentPoints = Words["I"]
                    updatePositions()
                    task.wait(1.5)
                    if not isAnimating then break end
                    currentPoints = Words["LOVE"]
                    updatePositions()
                    task.wait(1.5)
                    if not isAnimating then break end
                    currentPoints = Words["YOU"]
                    updatePositions()
                    task.wait(1.5)
                end
            end)
        elseif wordKey == "TILT_ANIM" then
            isAnimating = true
            mode = "SHAPE"
            local angle = 0
            local angleDirection = 0.05
            local minY = math.huge
            for _, p in ipairs(Words["HAND"]) do
                if p.Y < minY then minY = p.Y end
            end

            currentTask = task.spawn(function()
                while isAnimating do
                    angle = angle + angleDirection
                    if angle > 0.5 then angleDirection = -0.05
                    elseif angle < -0.5 then angleDirection = 0.05 end

                    local tiltedPoints = {}
                    local cosA = math.cos(angle)
                    local sinA = math.sin(angle)

                    for _, point in ipairs(Words["HAND"]) do
                        local tempX = point.X
                        local tempY = point.Y - minY
                        local rotatedX = tempX * cosA - tempY * sinA
                        local rotatedY = tempX * sinA + tempY * cosA
                        table.insert(tiltedPoints, Vector3.new(rotatedX, rotatedY + minY, point.Z))
                    end

                    currentPoints = tiltedPoints
                    updatePositions()
                    task.wait(0.03)
                end
            end)
        else
            mode = "SHAPE"
            currentPoints = Words[wordKey] or Words["HAND"]
            updatePositions()
        end
    end)
end

