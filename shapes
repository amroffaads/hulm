local allowedKeywords = {"ريال", "gun", "Money", "فلوس", "cash", "نقود", "سلاح", "رصاص", "weapon", "money", "coins", "cash", "currency"}

local function isToolAllowed(toolName)
    if not toolName then return false end
    local nameLower = string.lower(toolName)
    for _, keyword in ipairs(allowedKeywords) do
        if string.find(nameLower, string.lower(keyword)) then return true end
    end
    return false
end

_G.AutoFiring = true
local autoFireTask = nil
local autoFireEnabled = true

local function startAutoFire()
    if autoFireTask then task.cancel(autoFireTask) end
    autoFireTask = task.spawn(function()
        while _G.AutoFiring and autoFireEnabled do
            local currentChar = player.Character
            if not currentChar then task.wait(0.5) continue end
            local tool = currentChar:FindFirstChildOfClass("Tool")
            if tool and isToolAllowed(tool.Name) then
                tool:Activate()
                task.wait(0)
            else
                task.wait(0.1)
            end
        end
        autoFireTask = nil
    end)
end

