local function captureCoin(child)
    if child:IsA("BasePart") and not child:IsDescendantOf(character) and not child:FindFirstChild("IsOrbiting") then
        if child.Size.X < 7 and child.Size.Y < 7 then
            local tag = Instance.new("BoolValue", child)
            tag.Name = "IsOrbiting"
            child.CanCollide = false
            child.Massless = true

            local attach = Instance.new("Attachment", child)
            local alignPos = Instance.new("AlignPosition", child)
            alignPos.Attachment0 = attach
            alignPos.RigidityEnabled = true
            alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment

            table.insert(activeCoins, {
                Instance = child,
                Align = alignPos,
                Offset = currentPoints[(#activeCoins % #currentPoints) + 1] or Vector3.new(0,0,0),
                Angle = math.random(0, 360),
                Height = math.random(-2, 3)
            })
        end
    end
end

local heartbeatConnection
heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
    if not root or not root.Parent then
        if character and character.Parent then
            root = character:FindFirstChild("HumanoidRootPart")
        end
        if not root then return end
    end

    if mode == "SHAPE" then
        local targetCFrame = root.CFrame * CFrame.new(0, verticalOffset, 0)
        for _, data in ipairs(activeCoins) do
            if data.Instance and data.Align then
                data.Align.Position = (targetCFrame * CFrame.new(data.Offset)).Position
            end
        end
    elseif mode == "TORNADO" then
        for _, data in ipairs(activeCoins) do
            if data.Instance and data.Align then
                data.Angle = data.Angle + (rotationSpeed * deltaTime)
                local x = math.cos(data.Angle) * orbitRadius
                local z = math.sin(data.Angle) * orbitRadius
                data.Align.Position = root.Position + Vector3.new(x, data.Height, z)
            end
        end
    end
end)

