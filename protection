        local character = localPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if C_Desync.Enabled and DesyncSystemEnabled and character and character:FindFirstChild("HumanoidRootPart") and humanoid and humanoid.Health > 0 then
            local hrp = character.HumanoidRootPart
            C_Desync.OldPosition = hrp.CFrame

            if not dummyPart then
                dummyPart = Instance.new("Part")
                dummyPart.Anchored = true
                dummyPart.Transparency = 1
                dummyPart.CanCollide = false
                dummyPart.Name = "DesyncDummy"
                dummyPart.Parent = Workspace
                originalCameraSubject = Workspace.CurrentCamera.CameraSubject
                Workspace.CurrentCamera.CameraSubject = dummyPart
            end

            dummyPart.CFrame = C_Desync.OldPosition * CFrame.new(0, 1.5, 0)
            local calculatedPosition = C_Desync.OldPosition * CFrame.new(-9e9, -9e9, -9e9)

            hrp.CFrame = calculatedPosition
            RunService.RenderStepped:Wait()
            hrp.CFrame = C_Desync.OldPosition
