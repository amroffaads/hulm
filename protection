            if not AntiCopyEnabled or IsResetting then return end
            if (os.clock() - CharacterTime < 0.3) then return end
            if not obj or not obj.Parent then return end
            if WHITELISTED_CLASSES[obj.ClassName] or obj:IsA("Accessory") or obj:FindFirstAncestorOfClass("Tool") then return end

            local name = obj.Name
            local lowerName = name:lower()
            if string.find(lowerName, "head") or string.find(lowerName, "torso") or string.find(lowerName, "leg") or
               string.find(lowerName, "arm") or string.find(lowerName, "root") or string.find(lowerName, "hd") or
               string.find(lowerName, "mesh") or string.find(lowerName, "weld") then return end

            if obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart") then
                DelayedRE("بكج نسخ")
            end
        end)
    end

    -- ====== وظائف مضاد الرقص المجاني ======
    local function autoStopDances()
        if not FreeAntiDanceEnabled then return end
        local currentTime = os.clock()
        if currentTime - danceStopperCooldown < 0 then return end
        danceStopperCooldown = currentTime

        local character = localPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local animator = humanoid:FindFirstChild("Animator")
        if not animator then return end

        local animationTracks = animator:GetPlayingAnimationTracks()
        for _, track in pairs(animationTracks) do
            if track and track.Animation then
                local animName = track.Animation.Name
                local lowerName = animName:lower()
                local isDance = false

                if string.match(lowerName, "^hd%-%d+$") then
                    local numbers = string.match(lowerName, "%d+")
                    if numbers and #numbers >= 10 then isDance = true end
                end

                if not isDance then
                    local danceKeywords = {"dance", "رقص", "الرقص", "dancing", "move", "حركة", "moves", "animation"}
                    for _, keyword in ipairs(danceKeywords) do
                        if string.find(lowerName, keyword) then isDance = true break end
                    end
                end

                if isDance then
                    local ignored = false
                    for itemName, _ in pairs(IGNORED_ITEMS_FREE) do
                        if animName == itemName then ignored = true break end
                    end
                    if not ignored then track:Stop() end
                end
            end
        end
    end

    local function startDanceStopper()
        if danceStopperRunning then return end
        danceStopperRunning = true
        task.spawn(function()
            while FreeAntiDanceEnabled do
                autoStopDances()
                task.wait(0.3)
            end
            danceStopperRunning = false
        end)
    end

    -- ====== وظائف مضاد الرقص (undog) ======
    local function isDanceAnimation(item)
        if not item:IsA("Animation") then return false end
        if IGNORED_ITEMS_DANCE[item.Name] then return false end
        if string.match(item.Name, "^HD%-%d+$") then
            local numbers = string.match(item.Name, "%d+")
            if numbers and #numbers >= 10 then return true end
        end
        local lowerName = item.Name:lower()
        local danceKeywords = {"dance", "رقص", "الرقص", "dancing", "move", "حركة", "moves", "animation"}
        for _, keyword in ipairs(danceKeywords) do
            if string.find(lowerName, keyword) then return true end
        end
        return false
    end

    local function executeUndog()
        if not AntiDanceEnabled then return end
        local currentTime = os.clock()
        if currentTime - lastUndogTime > COOLDOWN then
            lastUndogTime = currentTime
            pcall(function() sendHDCommand("undog") end)
        end
    end

    local function scanExistingAnimations()
        if not AntiDanceEnabled or not localPlayer.Character then return end
        for _, desc in pairs(localPlayer.Character:GetDescendants()) do
            if desc:IsA("Animation") and isDanceAnimation(desc) then
                executeUndog()
                break
            end
        end
    end

    local function monitorCharacterAntiDance(character)
        if not character then return end
        character.DescendantAdded:Connect(function(desc)
            if not AntiDanceEnabled then return end
            if desc:IsA("Tool") or desc:FindFirstAncestorOfClass("Tool") then return end
            if desc:IsA("Animation") then
                task.wait(0)
                if isDanceAnimation(desc) then executeUndog() return end
            end
            if desc:IsA("AnimationTrack") and desc.Animation then
                if isDanceAnimation(desc.Animation) then executeUndog() return end
            end
        end)
    end

    -- ====== وظائف مضاد الفلينج ======
    local function getValidTarget()
        local list = {}
        local usedNames = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer then
                local name = p.Name
                local lowerName = name:lower()
                local isDuplicate = false
                if usedNames[lowerName] then isDuplicate = true
                else
                    for existingName, _ in pairs(usedNames) do
                        local matchCount = 0
                        for i = 1, math.min(#lowerName, #existingName) do
                            if lowerName:sub(i,i) == existingName:sub(i,i) then matchCount = matchCount + 1 end
                        end
                        if matchCount >= 3 then isDuplicate = true break end
                    end
                end
                if not isDuplicate then table.insert(list, name) usedNames[lowerName] = true end
            end
        end
        if #list == 0 then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer then table.insert(list, p.Name) end
            end
        end
        return (#list > 0) and list[math.random(1, #list)] or nil
    end

    -- ====== وظائف مضاد كلبش الأدمن ======
    local function detectAdminCuff()
        if not AntiCuffEnabled then return false end
        local character = localPlayer.Character
        if not character then return false end
        for _, child in pairs(character:GetChildren()) do
            local childName = child.Name:lower()
            for _, keyword in ipairs(ADMIN_CUFF_KEYWORDS) do
                if childName == keyword or (child:IsA("Tool") and string.find(childName, keyword)) then return true end
            end
        end
        return false
    end

    -- ====== وظائف مضاد نسخ الأدمن ======
    local function DelayedREAdmin(reason)
        if IsResettingAdmin or not AntiCopyAdminEnabled then return end
        IsResettingAdmin = true
        pcall(function()
            local root = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then root.Anchored = true end
        end)
        task.wait(ConfigAdmin.WaitTime)
        sendRECommand()
        task.wait(1)
        IsResettingAdmin = false
    end

    local function monitorCharacterAntiCopyAdmin(character)
        if not character or not AntiCopyAdminEnabled then return end
        CharacterTimeAdmin = os.clock()
        local humanoid = character:WaitForChild("Humanoid")
        for _, v in pairs(humanoid:GetChildren()) do
            if v:IsA("NumberValue") and string.find(v.Name, "Scale") then
                v.Changed:Connect(function()
                    if ConfigAdmin.AntiCopyAndSize and not IsResettingAdmin and (os.clock() - CharacterTimeAdmin > 0.5) then
                        DelayedREAdmin("تغيير حجم")
                    end
                end)
            end
        end
        character.ChildAdded:Connect(function(obj)
            if not ConfigAdmin.AntiCopyAndSize or IsResettingAdmin then return end
            if (os.clock() - CharacterTimeAdmin < 0.3) then return end
            if not obj or not obj.Parent then return end
            if WHITELISTED_CLASSES_ADMIN[obj.ClassName] or obj:IsA("Accessory") or obj:FindFirstAncestorOfClass("Tool") then return end
            local name = obj.Name
            if string.find(name, "Head") or string.find(name, "Torso") or string.find(name, "Leg") or
               string.find(name, "Arm") or string.find(name, "Root") or string.find(name, "HD") then return end
            if obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart") then DelayedREAdmin("بكج نسخ") end
        end)
    end

    -- ====== وظائف مضاد الكلبش الخاص ======
    local function handleToolAction(active)
        local character = localPlayer.Character
        if not character then return end
        local tool = character:FindFirstChild(TOOL_NAME) or localPlayer.Backpack:FindFirstChild(TOOL_NAME)
        if tool and tool:IsA("Tool") then
            if active then
                tool.Parent = character
                tool.Grip = CFrame.new(Vector3.new(1.5, 5, -0.5)) * CFrame.Angles(math.rad(90), 0, 0)
            else
                tool.Grip = CFrame.new(0, 0, 0)
            end
        end
    end

