    -- ====== وظائف مضاد الكلبش العادي ======
    local function antiCuffSystemNormal()
        if not AntiCuffNormalEnabled then return end
        local character = localPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart")
        if humanoid and root then
            humanoid.Sit = true
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            if humanoid.MoveDirection.Magnitude > 0 then
                local moveDir = humanoid.MoveDirection
                root.Velocity = Vector3.new(moveDir.X * 16, root.Velocity.Y, moveDir.Z * 16)
            end
            local hasCuff = false
            for _, v in pairs(character:GetChildren()) do
                if v:IsA("Tool") and (string.find(v.Name:lower(), "cuff") or v.Name == "Handcuffs") then
                    hasCuff = true break
                end
            end
            if hasCuff then
                for i = 1, 10 do
                    humanoid.Sit = false
                    task.wait(0.05)
                    humanoid.Sit = true
                    task.wait(0.05)
                end
                if humanoid.MoveDirection.Magnitude > 0 then
                    local moveDir = humanoid.MoveDirection
                    root.Velocity = Vector3.new(moveDir.X * 50, 10, moveDir.Z * 50)
                end
            end
        end
    end

