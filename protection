    local function resetCamera()
        if dummyPart then
            if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
                Workspace.CurrentCamera.CameraSubject = localPlayer.Character.Humanoid
            else
                Workspace.CurrentCamera.CameraSubject = originalCameraSubject
            end
            dummyPart:Destroy()
            dummyPart = nil
        end
    end

    local function enableDesync()
        C_Desync.Enabled = true
    end

    local function disableDesync()
        C_Desync.Enabled = false
        if C_Desync.OldPosition and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            localPlayer.Character.HumanoidRootPart.CFrame = C_Desync.OldPosition
        end
        C_Desync.OldPosition = nil
        resetCamera()
    end

    local function startDesyncLoop()
        if desyncLoopThread then return end
        desyncLoopThread = task.spawn(function()
            while toggleDesyncLoop and DesyncSystemEnabled do
                enableDesync()
                task.wait(0.15)
                disableDesync()
                task.wait(0.15)
            end
            desyncLoopThread = nil
        end)
    end

    localPlayer.CharacterAdded:Connect(function(character)
        toggleDesyncLoop = false
        disableDesync()
    end)

