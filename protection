    RunService.Heartbeat:Connect(function(dt)
        if not SystemEnabled then missingTime = 0 return end
        local char = localPlayer.Character
        local isMissing = (char == nil) or (char.Parent == nil) or (not char:FindFirstChild("HumanoidRootPart"))
        if isMissing then
            missingTime = missingTime + dt
            if missingTime >= 0.5 and not isProtectorActive then
                isProtectorActive = true
                task.spawn(function()
                    local target = getValidTarget()
                    if target then
                        sendHDCommand("to " .. target)
                        local characterFound = false
                        local timeout = 5
                        local startWait = tick()
                        while not characterFound and (tick() - startWait) < timeout and SystemEnabled do
                            local newChar = localPlayer.Character
                            if newChar and newChar:FindFirstChild("HumanoidRootPart") and newChar.Parent ~= nil then
                                task.wait(0.1)
                                newChar.HumanoidRootPart.CFrame = CFrame.new(SafeLocation)
                                characterFound = true
                            end
                            task.wait(0.1)
                        end
                    end
                    isProtectorActive = false
                    missingTime = 0
                end)
            end
        else
            missingTime = 0
        end
    end)

