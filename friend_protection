local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer
local playerName = LocalPlayer.Name

local API_BASE = "https://amr-s-domino-control-panel.onrender.com/api"
local API_BACKUP = "https://amr-s-domino-control-panel.vercel.app/api"

local function CheckPermission(permName)
    local function tryUrl(base)
        local fullUrl = base .. "/check?username=" .. HttpService:UrlEncode(playerName)
        local success, response = pcall(function()
            return game:HttpGet(fullUrl)
        end)
        if not success then return nil end
        local ok, data = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if not ok or type(data) ~= "table" then return nil end
        local perms = data.permissions or data
        return perms[permName] == true
    end
    local result = tryUrl(API_BASE)
    if result == nil then result = tryUrl(API_BACKUP) end
    return result == true
end

if not CheckPermission("friendprotection") then
    return
end

