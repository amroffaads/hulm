    -- ====== وظائف مساعدة ======
    local function IsCuffed(player)
        if not player or not player.Character then return false end
        for _, child in pairs(player.Character:GetChildren()) do
            local name = child.Name:lower()
            for _, kw in ipairs(CUFF_KEYWORDS) do
                if name == kw or (child:IsA("Tool") and name:find(kw)) then
                    return true
                end
            end
        end
        return false
    end

    local function AntiCuff_Execute()
        local target = Systems.AntiCuff.Target
        if not target or not Systems.AntiCuff.Active then return end
        local now = os.clock()
        if now - Systems.AntiCuff.LastReTime < Systems.AntiCuff.Cooldown then return end
        Systems.AntiCuff.LastReTime = now

        StarterGui:SetCore("SendNotification", {Title = "🔒 مضاد الكلبشة", Text = ".re " .. target.Name, Duration = 1})
        sendHDCommand("re " .. target.Name)
    end

    -- ====== نظام مضاد نسخ مجاني ======
    local function AntiCopyFree_Execute()
        local target = Systems.AntiCopyFree.Target
        if Systems.AntiCopyFree.IsResetting or not target or not Systems.AntiCopyFree.Active then return end
        Systems.AntiCopyFree.IsResetting = true

        StarterGui:SetCore("SendNotification", {Title = "🛡️ مضاد النسخ المجاني", Text = "تطهير " .. target.Name, Duration = 1})
        sendHDCommand("char " .. target.Name .. " 1")
        task.wait(1)
        sendHDCommand("unchar " .. target.Name)

        task.wait(0.5)
        Systems.AntiCopyFree.IsResetting = false
    end

    local function AntiCopyFree_Monitor(character)
        if not character or not Systems.AntiCopyFree.Active then return end
        local charTime = os.clock()

        character.ChildAdded:Connect(function(obj)
            if not Systems.AntiCopyFree.Active or Systems.AntiCopyFree.IsResetting then return end
            if (os.clock() - charTime < 0.3) then return end
            if ALLOWED_ITEMS[obj.ClassName] or obj:IsA("Accessory") then return end

            local name = obj.Name:lower()
            if name:match("head") or name:match("torso") or name:match("leg") or name:match("arm") then return end

            if obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart") then
                AntiCopyFree_Execute()
            end
        end)
    end

    -- ====== نظام مضاد نسخ أدمن ======
    local function AntiCopyAdmin_Execute()
        local target = Systems.AntiCopyAdmin.Target
        if Systems.AntiCopyAdmin.IsResetting or not target or not Systems.AntiCopyAdmin.Active then return end

        local now = os.clock()
        if now - Systems.AntiCopyAdmin.LastReTime < Systems.AntiCopyAdmin.Cooldown then return end
        Systems.AntiCopyAdmin.LastReTime = now
        Systems.AntiCopyAdmin.IsResetting = true

        StarterGui:SetCore("SendNotification", {Title = "👑 مضاد النسخ الأدمن", Text = ".re " .. target.Name, Duration = 1})

        pcall(function()
            if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                target.Character.HumanoidRootPart.Anchored = true
            end
        end)

        task.wait(0.2)
        sendHDCommand("re " .. target.Name)

        task.wait(1)
        Systems.AntiCopyAdmin.IsResetting = false

        pcall(function()
            if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                target.Character.HumanoidRootPart.Anchored = false
            end
        end)
    end

    local function AntiCopyAdmin_Monitor(character)
        if not character or not Systems.AntiCopyAdmin.Active then return end
        local charTime = os.clock()

        character.ChildAdded:Connect(function(obj)
            if not Systems.AntiCopyAdmin.Active or Systems.AntiCopyAdmin.IsResetting then return end
            if (os.clock() - charTime < 0.3) then return end
            if ALLOWED_ITEMS[obj.ClassName] or obj:IsA("Accessory") then return end

            local name = obj.Name:lower()
            if name:match("head") or name:match("torso") or name:match("leg") or name:match("arm") or
               name:match("root") or name:match("hd") then return end

            if obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart") then
                AntiCopyAdmin_Execute()
            end
        end)
    end

    -- ====== نظام مضاد رقص أدمن ======
    local function IsDance(anim)
        if not anim:IsA("Animation") then return false end
        if IGNORED_ITEMS[anim.Name] then return false end

        if anim.Name:match("^HD%-%d+$") then
            local nums = anim.Name:match("%d+")
            if nums and #nums >= 10 then return true end
        end

        local lower = anim.Name:lower()
        local words = {"dance", "رقص", "dancing", "move", "حركة", "animation"}
        for _, w in ipairs(words) do
            if lower:find(w) then return true end
        end
        return false
    end

    local function AntiDance_Execute()
        local target = Systems.AntiDance.Target
        if not target or not Systems.AntiDance.Active then return end
        local now = os.clock()
        if now - Systems.AntiDance.LastExecTime < Systems.AntiDance.Cooldown then return end
        Systems.AntiDance.LastExecTime = now
        sendHDCommand("undog " .. target.Name)
    end

    local function AntiDance_Monitor(character)
        if not character or not Systems.AntiDance.Active then return end
        character.DescendantAdded:Connect(function(desc)
            if not Systems.AntiDance.Active then return end
            if desc:IsA("Tool") then return end
            if desc:IsA("Animation") and IsDance(desc) then
                task.wait(0)
                AntiDance_Execute()
            end
        end)
    end

    -- ====== ربط الأزرار ======
    local function toggleSystem(system, btnData, systemName, systemKey)
        if system.Active then
            system.Active = false
            system.Target = nil
            btnData.Btn.Text = "○ إيقاف"
            btnData.Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
            btnData.Btn.TextColor3 = Color3.fromRGB(180, 180, 200)
            StarterGui:SetCore("SendNotification", {Title = "⏹️ " .. systemName, Text = "تم إيقاف الحماية", Duration = 2})
        else
            local targetName = PlayerNameBox.Text
            if targetName and targetName ~= "" then
                local target = FindPlayer(targetName)
                if target then
                    system.Active = true
                    system.Target = target
                    btnData.Btn.Text = "● " .. target.Name
                    btnData.Btn.BackgroundColor3 = btnData.Accent
                    btnData.Btn.TextColor3 = Color3.new(1, 1, 1)

                    if target.Character then
                        if systemKey == "AntiCopyFree" then
                            AntiCopyFree_Monitor(target.Character)
                        elseif systemKey == "AntiCopyAdmin" then
                            AntiCopyAdmin_Monitor(target.Character)
                        elseif systemKey == "AntiDance" then
                            AntiDance_Monitor(target.Character)
                            task.wait(1)
                            for _, desc in pairs(target.Character:GetDescendants()) do
                                if desc:IsA("Animation") and IsDance(desc) then
                                    AntiDance_Execute()
                                    break
                                end
                            end
                        end
                    end

                    StarterGui:SetCore("SendNotification", {
                        Title = "✅ " .. systemName,
                        Text = "الحماية مفعلة لـ " .. target.Name,
                        Duration = 3
                    })
                else
                    StarterGui:SetCore("SendNotification", {Title = "❌ خطأ", Text = "لم يتم العثور على اللاعب", Duration = 2})
                end
            else
                StarterGui:SetCore("SendNotification", {Title = "⚠️ تنبيه", Text = "اكتب اسم اللاعب أولاً", Duration = 2})
            end
        end
    end

