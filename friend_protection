                Size = UDim2.new(0, 220, 0, 290)
            }):Play()
            task.wait(0.25)
            InputFrame.Visible = true
            for _, btn in pairs(Btns) do
                btn.Frame.Visible = true
            end
            MinimizeBtn.Text = "−"
        end
    end)

    MinimizeBtn.MouseEnter:Connect(function()
        TweenService:Create(MinimizeBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(70, 70, 90)}):Play()
    end)
    MinimizeBtn.MouseLeave:Connect(function()
        TweenService:Create(MinimizeBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 70)}):Play()
    end)

    -- ====== المراقبات ======
    RunService.Heartbeat:Connect(function()
        if Systems.AntiCuff.Active and Systems.AntiCuff.Target and IsCuffed(Systems.AntiCuff.Target) then
            AntiCuff_Execute()
        end
    end)

    local function onCharacterAdded(player)
        player.CharacterAdded:Connect(function(character)
            task.wait(0.5)
            if Systems.AntiCopyFree.Active and Systems.AntiCopyFree.Target == player then
                AntiCopyFree_Monitor(character)
            end
            if Systems.AntiCopyAdmin.Active and Systems.AntiCopyAdmin.Target == player then
                AntiCopyAdmin_Monitor(character)
            end
            if Systems.AntiDance.Active and Systems.AntiDance.Target == player then
                AntiDance_Monitor(character)
            end
        end)
    end

    for _, p in ipairs(Players:GetPlayers()) do onCharacterAdded(p) end
    Players.PlayerAdded:Connect(onCharacterAdded)

    Players.PlayerRemoving:Connect(function(p)
        for _, sys in pairs(Systems) do
            if sys.Target == p then
                sys.Active = false
                sys.Target = nil
            end
        end
        for _, btn in pairs(Btns) do
            if btn.Btn.Text:find(p.Name) then
                btn.Btn.Text = "○ إيقاف"
                btn.Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
                btn.Btn.TextColor3 = Color3.fromRGB(180, 180, 200)
            end
        end
    end)

    -- أنيميشن دخول
    MainFrame.Size = UDim2.new(0, 220, 0, 0)
    MainFrame.BackgroundTransparency = 1
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 220, 0, 290),
        BackgroundTransparency = 0.05
    }):Play()

    StarterGui:SetCore("SendNotification", {
        Title = "🛡️ حماية الصديق",
        Text = "النظام جاهز (4 أنظمة حماية)",
        Duration = 3
    })
